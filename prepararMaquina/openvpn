# generar el certificado del servidor
./build-key-server server
# Generar el certificado Diffie-Hellman
./build-dh
# Generar el certificado HMAC
openvpn --genkey --secret keys/ta.key
# Copiar los certificados y claves al directorio de OpenVPN
cd keys
sudo cp ca.crt ca.key dh2048.pem ta.key server.crt server.key /etc/openvpn
# Copiar el archivo de configuración del servidor
sudo cp /usr/share/doc/openvpn/examples/sample-config-files/server.conf.gz /etc/openvpn 
sudo gzip -d /etc/openvpn/server.conf.gz | tee /etc/openvpn/server.conf # tee verifica que el archivo se haya descomprimido correctamente
# Editar el archivo de configuración del servidor
sudo nano /etc/openvpn/server.conf

# Configuracon del archivo de configuración
ca ca.crt
cert server.crt
dev tun
dh dh2048.pem
server ip mask # confiurar ne direccon de red
push "redirect-gateway def1 bypass-dhcp"
keeplive 10 120
chipher AES-256-CBC # cambiar el cifrado
lts-auth ta.key 0 # 
persist-key
persist-tun 
user nobody
group nogroup
satus openvpn-status.log
log-append /var/log/
verb 3


# Configuracain sysctl.conf
nano /etc/sysctl.conf
net.ipv4.ip_forward=1 # para desactivar el reenvio de paquetes  
sudo sysctl -p # para aplicar los cambios
# Configurar el firewall    
ufw allow 1194/udp # abrir el puerto 1194
# Configurar el firewall iptables
sudo iptables -t nat -A POSTRUTING -s 10.8.0.0./24 -o et0 -j MASQUERADE # creamos una regla de NAT
sudo apt install iptables-persistent -y # instalar el paquete para guardar las reglas
# Aolicar el en ipv4 y ipv6
sudo netfilter-persistent save
sudo sh -c "iptables-save > /etc/iptables/rules.v4"
sudo sh -c "ip6tables-save > /etc/iptables/rules.v6"
sudo service iptables-persistent restart # reiniciar el servicio
sudo service openvpn enable # habilitar el servicio


